# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
# Development:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gymntonic_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Production (set this in your hosting env vars):
# DATABASE_URL=postgres://user:password@host:5432/gymntonic_db?sslmode=require

# JWT — IMPORTANT: Generate strong secrets for production!
# Run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx
PAYSTACK_WEBHOOK_SECRET=whsk_xxxxx

# Crypto Payments
CRYPTO_WALLET_BTC=your-btc-wallet-address
CRYPTO_WALLET_ETH=your-eth-wallet-address
CRYPTO_WALLET_USDT=your-usdt-wallet-address

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=GymNTonic <noreply@gymntonic.com>

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
